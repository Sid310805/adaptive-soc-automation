# =========================
# Dashboard
# =========================
@app.route("/", methods=["GET", "POST"])
def dashboard():
    
    critical = len([x for x in logs if x["level"] == "error"])
    warnings = len([x for x in logs if x["level"] == "warning"])

    status = {
        "message": "Wazuh Manager Running"
    }

    answer = ""

    if request.method == "POST":
        prompt = request.form["prompt"]
        answer = explain(prompt)

    return render_template(
        "dashboard.html",
        logs=logs,
        agents=agents,
        critical=critical,
        warnings=warnings,
        status=status,
        answer=answer
    )
# =========================
# Sidebar Pages
# =========================

@app.route("/logs")
def live_logs():

    return render_template(
        "logs.html",
        logs=logs
    )



@app.route("/agents")
def agent_page():

    return render_template(
        "agents.html",
        agents=agents
    )



@app.route("/incidents")
def incidents():

    incident_logs = [
        log for log in logs
        if log["level"] in ["error","warning"]
    ]

    return render_template(
        "incidents.html",
        incidents=incident_logs
    )



@app.route("/reports")
def reports():

    return render_template(
        "reports.html"
    )



@app.route("/settings")
def settings():

    return render_template(
        "settings.html"
    )

@app.route("/chat", methods=["GET", "POST"])
def chat():
    answer = ""

    if request.method == "POST":
        prompt = request.form["prompt"]
        answer = explain(prompt)

    return render_template(
        "chat.html",
        answer=answer
    )

# =========================
# API Endpoints
# (For future React/API use)
# =========================


@app.route("/api/logs")
def api_logs():

    return jsonify(logs)



@app.route("/api/agents")
def api_agents():

    return jsonify(agents)



@app.route("/api/status")
def api_status():

    return jsonify({

        "server":"running",

        "time":
        datetime.now().strftime(
            "%Y-%m-%d %H:%M:%S"
        )

    })
